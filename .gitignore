# ===================================================================
# Mental Math Game – Root .gitignore
# ===================================================================

# 1. Environment Variables & Sensitive Credentials
# Exclude all .env and .env.* files, but explicitly allow .env.example files
.env
.env.*
!.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
**/.env
**/.env.*
!**/.env.example
*.env
*.pem
*.key
credentials.json

# 2. Build Output & Compiled Binaries
target/
**/target/
*.class
*.jar
*.war
*.ear

# 3. Frontend Dependencies, Caches & Production Bundles
node_modules/
**/node_modules/
dist/
**/dist/
frontend/dist/
.vite/
**/.vite/
.npm/

# 4. IDE & Editor Configuration Files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
.classpath
.project
.settings/
*.launch

# 5. Operating System Temporary Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.tmp
*~

# 6. Log Files & Crash Reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. Local Scratch / Temp Folders
scratch/
tmp/
temp/
