# ===================================================================
# Mental Math Game – .gitignore
# ===================================================================

# Java & Maven Build Artifacts
target/
*.class
*.jar
*.war
*.ear

# Frontend Dependencies & Production Bundles
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.npm/
.vite/
frontend/.vite/

# Environment Variables & Sensitive Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
*.env
*.pem
*.key
credentials.json

# IDE & Editor Configurations
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.classpath
.project
.settings/
*.launch

# OS Generated Files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Log Files & Crash Reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temporary files
scratch/
tmp/
temp/
