# ===================================================================
# Mental Math Game – Backend Environment Variables Example
# Copy this file to .env or configure in your cloud hosting provider dashboard
# ===================================================================

# Server Port (default 8081 for local development; cloud platforms provide PORT dynamically)
PORT=8081

# MySQL Database Connection URL
# Local Development:
DB_URL=jdbc:mysql://localhost:3306/mental_math_game?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Cloud Hosting (e.g., Aiven / Railway / AWS):
# DB_URL=jdbc:mysql://<host>:<port>/mental_math_game?sslMode=REQUIRED&serverTimezone=UTC

# Database Username
DB_USER=your_db_username

# Database Password (leave empty for passwordless local root or enter your password)
DB_PASSWORD=your_db_password
